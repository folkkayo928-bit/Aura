# Client/public configuration
APP_URL="https://your-aura-domain.example"

# Server-only Telegram configuration. Never expose the bot token to browser code.
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN"
PUBLIC_APP_URL="https://your-aura-domain.example"
TELEGRAM_WEBAPP_URL="https://your-aura-domain.example"
TELEGRAM_WEBHOOK_SECRET="GENERATE_A_LONG_RANDOM_SECRET"


# Supabase public browser configuration
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_PUBLIC_KEY"

# Optional thirdweb public Client ID for the isolated Base Sepolia wallet preview.
# Restrict allowed origins in thirdweb. Never use a Secret Key in any VITE_ variable.
VITE_THIRDWEB_CLIENT_ID="YOUR_PUBLIC_THIRDWEB_CLIENT_ID"
