# Server-only thirdweb configuration for Supabase Edge Functions (never prefix these with VITE_).
# THIRDWEB_SECRET_KEY="YOUR_THIRDWEB_PROJECT_SECRET_KEY"
# THIRDWEB_SERVER_WALLET_ADDRESS="0xYourRegisteredServerWalletAddress"

# Required in Supabase Edge Function secrets for each real USDT withdrawal network.
# Treasury address must match the sender registered under this Thirdweb project.
# AURA_EVM_TREASURY_ETHEREUM="0xYourEthereumTreasury"
# AURA_EVM_TREASURY_POLYGON="0xYourPolygonTreasury"
# AURA_EVM_TREASURY_ARBITRUM="0xYourArbitrumTreasury"
# AURA_EVM_TREASURY_BSC="0xYourBscTreasury"
#
# Optional network-specific RPC overrides (public read fallbacks exist).
# AURA_EVM_RPC_ETHEREUM="https://your-ethereum-rpc"
# AURA_EVM_RPC_POLYGON="https://your-polygon-rpc"
# AURA_EVM_RPC_ARBITRUM="https://your-arbitrum-rpc"
# AURA_EVM_RPC_BSC="https://your-bsc-rpc"
#
# Smart-account payout is blocked until a controlled send is verified.
# Set AURA_THIRDWEB_GAS_VERIFIED_<NETWORK>=true only after confirming a real
# small test transfer on that exact chain; do not set this preemptively.

# Client/public configuration
APP_URL="https://your-aura-domain.example"

# Server-only Telegram configuration. Never expose the bot token to browser code.
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN"
PUBLIC_APP_URL="https://your-aura-domain.example"
TELEGRAM_WEBAPP_URL="https://your-aura-domain.example"
TELEGRAM_WEBHOOK_SECRET="GENERATE_A_LONG_RANDOM_SECRET"


# Supabase public browser configuration
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_PUBLIC_KEY"

# Optional thirdweb public Client ID for the isolated Base Sepolia wallet preview.
# Restrict allowed origins in thirdweb. Never use a Secret Key in any VITE_ variable.
VITE_THIRDWEB_CLIENT_ID="YOUR_PUBLIC_THIRDWEB_CLIENT_ID"
