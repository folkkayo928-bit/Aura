# AURA web server configuration
APP_URL="https://your-aura-domain.example"

# Optional authenticated dRPC JSON-RPC overrides.
# Store these in Supabase Edge Function secrets, not in frontend VITE_ variables.
# These are RPC URLs for server-side indexer/legacy reconciliation only.
# AURA_EVM_RPC_ETHEREUM="https://your-authenticated-ethereum-rpc"
# AURA_EVM_RPC_POLYGON="https://your-authenticated-polygon-rpc"
# AURA_EVM_RPC_ARBITRUM="https://your-authenticated-arbitrum-rpc"
# AURA_EVM_RPC_BSC="https://your-authenticated-bsc-rpc"

# Legacy custody migration only.
# Keep legacy custody/treasury secrets in Supabase until old deposits and ledger
# balances are reconciled. Do not use these values to store new user recovery phrases.
# AURA_EVM_TREASURY_ETHEREUM="0xLegacyTreasuryAddress"
# AURA_EVM_TREASURY_POLYGON="0xLegacyTreasuryAddress"
# AURA_EVM_TREASURY_ARBITRUM="0xLegacyTreasuryAddress"
# AURA_EVM_TREASURY_BSC="0xLegacyTreasuryAddress"

# Server-only Telegram configuration. Never expose the bot token to browser code.
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN"
PUBLIC_APP_URL="https://your-aura-domain.example"
TELEGRAM_WEBAPP_URL="https://your-aura-domain.example"
TELEGRAM_WEBHOOK_SECRET="GENERATE_A_LONG_RANDOM_SECRET"

# Supabase public browser configuration
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_PUBLIC_KEY"
